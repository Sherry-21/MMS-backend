# Application Configuration
APP_NAME="Maiora System Backend"
APP_ENV="development"
PORT="8080"

# Server Timeouts
READ_TIMEOUT="15s"
WRITE_TIMEOUT="15s"
IDLE_TIMEOUT="60s"

# Database Configuration (Neon DB / PostgreSQL)
# Option 1: Direct Neon Connection URI (Recommended for Neon DB)
DATABASE_URL="postgres://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Option 2: Discrete DB Parameters (Fallback if DATABASE_URL is empty)
DB_HOST="ep-sample-123456.us-east-2.aws.neon.tech"
DB_PORT="5432"
DB_USER="user"
DB_PASSWORD="password"
DB_NAME="neondb"
DB_SSLMODE="require"

# Database Pool Settings
DB_MAX_OPEN_CONNS="25"
DB_MAX_IDLE_CONNS="10"
DB_CONN_MAX_LIFETIME="5m"

# CORS Configuration
ALLOWED_ORIGINS="*"
ALLOWED_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
ALLOWED_HEADERS="Accept,Authorization,Content-Type,X-CSRF-Token"
ALLOW_CREDENTIALS="true"

# JWT Authentication
JWT_ACCESS_EXPIRATION_MINUTES="15"
JWT_REFRESH_EXPIRATION_DAYS="7"
SECRET_KEY="f11f22b67206c95e0bcc999dbbe96a0dc7c7d54f4009712957c014ef2228c683"
